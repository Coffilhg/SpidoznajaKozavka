			Components.UIListLayout {
				Direction = "Horizontal",
				XAlign = "Left",
				YAlign = "Center",
				Padding = UDim.new(0, 6),
			},
			Components.UIPadding {0, 1200},
		}
	}
	navSF.ClipsDescendants = false
	navSF.BackgroundTransparency = 1
	const navButtonBinds = {}
	const function navButton(SectionName: string, bindToPage: Instance | (...any) -&gt; ())
		const b = C "TextButton" {
			Size = UDim2.fromScale(0, 1),
			--Position = UDim2.fromScale(.5, .5),
			--AnchorPoint = Vector2.new(.5, .5),
			AutomaticSize = Enum.AutomaticSize.X,
			TextSize = 16,
			--TextWrapped = true,
			--TextScaled = true,
			Text = `&lt;b&gt;{SectionName}&lt;/b&gt;`,
			RichText = true,
			Components.UIPadding({3, 6}),
			BackgroundTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Colors["Text (Primary)"],
			(C :: any) "UIScale" {
				Scale = 1,
			},
		}
		
		b.Parent = navSF
		
		const gb = GreatUIButton(b, b, {
			TweenInfo = TweenInfo.new(0.3),
			UIScale = {
				TweenInfo = TweenInfo.new(0.3),
				Scale = 1,
			},
		}):SetAppearance("Hover", {
			TweenInfo = TweenInfo.new(0.3),
			UIScale = {
				TweenInfo = TweenInfo.new(0.3),
				Scale = 1.08,
			},
		}):SetAppearance("Press", {
			TweenInfo = TweenInfo.new(0.3),
			UIScale = {
				TweenInfo = TweenInfo.new(0.3),
				Scale = 0.9,
			},
		}, true):ApplyAppearance("Default")
		
		if type(bindToPage) == `function` then
			gb.OnPressStart:Connect(bindToPage)
			
			const cube = C "UIAspectRatioConstraint" {
				AspectRatio = 1,
			}
			cube.Parent = b
			b.Size = UDim2.fromScale(1, 1)
		else
			gb.OnPressStart:Connect(function()
				pageLayout:JumpTo(bindToPage)
			end)

			navButtonBinds[bindToPage] = b
		end
		
		return b
	end
	
	const function syncSections(page: Instance)
		const b = navButtonBinds[page]
		if not b then
			return
		end
		const xPosition = b.AbsolutePosition.X - navSF.AbsolutePosition.X + navSF.CanvasPosition.X
		--print(xPosition)
		navSF.CanvasPosition = Vector2.new(xPosition, 0)
	end
	
	pageLayout.PageEnter:Connect(syncSections)
	
	navButton(RichGradient:Apply(`Outfit Loader`, PremiumGradient, true), MainSF)
	navButton(RichGradient:Apply(`Settings`, ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(190, 255, 60)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 255, 125)),
	}), true), SettingsSF)
	navButton(`Output`, richOutputSF)
	navButton(RichGradient:Apply(`License &amp; Legal`, Colors["Text (Primary)"], Colors.Backgroung), LegalSF)
	
	syncSections(MainSF)
	
	
	
	-- https://create.roblox.com/docs/ui/rich-text#escape-forms for lt and gt
	const navBack = navButton(`&amp;lt;`, function()
		pageLayout:Previous()
	end)
	navBack.Position = UDim2.fromScale(0, .5)
	navBack.AnchorPoint = Vector2.new(0, .5)
	navBack.ZIndex = 10
	navBack.TextScaled = true
	navBack.BackgroundColor3 = Colors["Div"]
	navBack.BackgroundTransparency = 0
	navBack.TextXAlignment = Enum.TextXAlignment.Center
	navBack.AutomaticSize = Enum.AutomaticSize.None
	navBack.Size = UDim2.fromScale(.1, 1)
	;(C "UICorner" {
		CornerRadius = UDim.new(0, 4)
	}).Parent = navBack

	const navFront = navButton(`&amp;gt;`, function()
		pageLayout:Next()
	end)
	navFront.Position = UDim2.fromScale(1, .5)
	navFront.AnchorPoint = Vector2.new(1, .5)
	navFront.ZIndex = 10
	navFront.TextScaled = true
	navFront.BackgroundColor3 = Colors["Div"]
	navFront.BackgroundTransparency = 0
	navFront.TextXAlignment = Enum.TextXAlignment.Center
	navFront.AutomaticSize = Enum.AutomaticSize.None
	navFront.Size = UDim2.fromScale(.1, 1)
	;(C "UICorner" {
		CornerRadius = UDim.new(0, 4)
	}).Parent = navFront
	
	const nav = Components.Div {
		AnchorPoint = Vector2.new(.5, .5),
		Size = UDim2.fromScale(0.76, 0.09),
		Position = UDim2.new(.5, 0, 0.09, 0),
		Radius = 4,
		AutoSize = "None",
		Children = {
			navSF,
			navBack,
			navFront
		},
	}
	nav.ClipsDescendants = true
	nav.ZIndex = 7
	nav.Parent = Widget

	return m
end, Widget)

Ask:FixGreatUIButtonLooks()
for _, greatUIButton in GreatUIButtons do
	--print(greatUIButton)
	greatUIButton:ApplyAppearance("Default")
end

plugin.Unloading:Once(function()
	PluginBigSettingsStoreService:Shutdown()
end)</string>
          </Properties>
          <Item class="ModuleScript" referent="4">
            <Properties>
              <string name="Name">AdvancedNameColorPredictor</string>
              <string name="Source">--!strict
--!optimize 2

-- This script is an improved version of an example on devforum at:
-- https://devforum.roblox.com/t/your-name-color-in-chat-%E2%80%94-history-and-how-it-works/2702247
-- more precisely here:
-- https://devforum.roblox.com/t/how-to-get-a-users-default-chat-colour-simple-module/957515/1
-- Improved &amp; Added Gradients by @Coffilhg (Roblox UserId 517222346)
-- Use this however you want; The gradient variants don't all exactly match the usual chat colors!

-- This module has first ever become public with SpidoznajaKozavka's V0.0.0 release. The gradients were invented in the middle (Summer) of 2025, I think they're pretty cool.
-- This is free and unencumbered software released into the public domain. Under the
-- Unlicense license: https://unlicense.org

type NAME_COLORS = {Color3}
type NAME_GRADIENTS = {ColorSequence}

local NAME_COLORS: NAME_COLORS =
	{
		Color3.new(0.992157, 0.160784, 0.262745), -- BrickColor.new("Bright red").Color,
		Color3.new(1/255, 162/255, 255/255), -- BrickColor.new("Bright blue").Color,
		Color3.new(2/255, 184/255, 87/255), -- BrickColor.new("Earth green").Color,
		BrickColor.new("Bright violet").Color,
		BrickColor.new("Bright orange").Color,
		BrickColor.new("Bright yellow").Color,
		BrickColor.new("Light reddish violet").Color,
		BrickColor.new("Brick yellow").Color,
	}
local NAME_GRADIENTS: NAME_GRADIENTS =
	{
		ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 100, 0)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 40)),
		}), -- 1: [Red] Good match
		ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 112, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 255, 223)),
		}), -- 2: [Bright blue] Somewhat matching
		ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(190, 255, 60)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 255, 125)),
		}), -- 3: [Earth green] Good match
		--ColorSequence.new({
		--	ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 255, 223)),
		--	ColorSequenceKeypoint.new(0.435, Color3.fromRGB(60, 180, 255)),
		--	ColorSequenceKeypoint.new(1, Color3.fromRGB(160, 60, 255)),
		--}), -- 3: [Earth green] Not at all matching
		ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 255)),
			ColorSequenceKeypoint.new(0.334, Color3.fromRGB(160, 60, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 112, 255)),
		}), -- 4: [Bright violet] Somewhat matching
		ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
			ColorSequenceKeypoint.new(0.428, Color3.fromRGB(255, 158, 60)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(67, 255, 60)),
		}), -- 5: [Bright orange] Somewhat matching
		ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(190, 255, 60)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 229, 60)),
		}), -- 6: [Bright yellow] Somewhat matching
		ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(160, 255, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 150, 255)),
		}), -- 7: [Light reddish violet] Not at all matching; But this looks Premium!
		-- the last one for 8: ["Crick Yellow"] can be either
		--ColorSequence.new({
		--	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
		--	ColorSequenceKeypoint.new(0.428, Color3.fromRGB(255, 158, 60)),
		--	ColorSequenceKeypoint.new(1, Color3.fromRGB(67, 255, 60)),
		--}), -- same as 5
		-- or this one
		ColorSequence.new({
			ColorSequenceKeypoint.new(0, BrickColor.new("Brick yellow").Color),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(253, 255, 133))
		}),
	}

local function GetNameValue(pName: string): number
	local value = 0
	for index = 1, #pName do
		local cValue = string.byte(string.sub(pName, index, index))
		local reverseIndex = #pName - index + 1
		if #pName%2 == 1 then
			reverseIndex = reverseIndex - 1
		end
		if reverseIndex%4 &gt;= 2 then
			cValue = -cValue
		end
		value = value + cValue
	end
	return value
end

local color_offset: number = 0

local module = {}

function module.ComputeNameNumber(pName : string) : number
	return ((GetNameValue(pName) + color_offset) % #NAME_COLORS) + 1
end

function module.ComputeNameColor(pName : string) : Color3
	return NAME_COLORS[((GetNameValue(pName) + color_offset) % #NAME_COLORS) + 1]
end

function module.ComputeNameGradient(pName : string) : ColorSequence
	return NAME_GRADIENTS[((GetNameValue(pName) + color_offset) % #NAME_GRADIENTS) + 1]
end

table.freeze(module)
return module</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="5">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source">--!strict
--!optimize 2

const LoopedPattern = require(`@self/LoopedPattern`)
export type Wrap_LoopedPattern = LoopedPattern.LoopedPattern

const Components = {
	Main = require(`@self/Main`),
	LoopedPattern = LoopedPattern,
	ScrollingFrame = require(`@self/ScrollingFrame`),
	Checkbox = require(`@self/Checkbox`),
	TextButton = require(`@self/TextButton`),
	UIListLayout = require(`@self/UIListLayout`),
	UIPadding = require(`@self/UIPadding`),
	Text = require(`@self/Text`),
	Pre = require(`@self/Pre`),
	PreNoWrap = require(`@self/PreNoWrap`),
	Div = require(`@self/Div`),
	RichOutput = require(`@self/RichOutput`),
	Ask = require(`@self/Ask`),
	PlayerProfile = require(`@self/PlayerProfile`),
	VirtualList = require(`@self/VirtualList`),
}

return Components</string>
            </Properties>
            <Item class="ModuleScript" referent="6">
              <Properties>
                <string name="Name">Ask</string>
                <string name="Source">--!strict
--!optimize 2

const TS = game:GetService(`TweenService`)
const TimelineTwInf = TweenInfo.new(
	12,
	Enum.EasingStyle.Linear,
	Enum.EasingDirection.InOut,
	0,
	false,
	0
)
const ToggleTwInf = TweenInfo.new(
	0.3,
	Enum.EasingStyle.Quad,
	Enum.EasingDirection.In,
	0,
	false,
	0
)
const TransitionTwInf = TweenInfo.new(0.1)

const LemonSignal = require(`../../Packages/LemonSignal`)
const GreatUIButton = require(`../../Packages/GreatUIButton`)
const Vide = require(`../../Packages/Vide`)
const C = Vide.create
const Style = require(`../Style`)
const Colors = Style.Colors
const FontFace = Style.Font
const RichOutput = require(`./RichOutput`)
const Button = require(`./TextButton`)
const UIPadding = require(`./UIPadding`)

export type AskObject = {
	read FixGreatUIButtonLooks: (self: AskObject) -&gt; (),
	read Reparent: (
		self: AskObject,
		newParent: Instance
	) -&gt; (),
	read OnAnswer: LemonSignal.Signal&lt;boolean, number&gt;,
	read Ask: (
		self: AskObject,
		questionRichText: string,
		denialButtonText: string,
		approvalButtonText: string
	) -&gt; (number),
}
local IsNotCreated: boolean? = true
local AskObject: AskObject

return function(
	props: {
		Parent: Instance?,
	}
)
	const RichOutputObject = RichOutput({} :: any)
	
	if not IsNotCreated then
		-- just in case IsNotCreated = true was set, but the object was not yet assigned
		if not AskObject then
			RichOutputObject:Warn(`Components.Ask: Race condition reached`)
			repeat task.wait() until AskObject
		end
		return AskObject
	end
	if not props.Parent then
		-- wait until main script inits this
		RichOutputObject:Warn(`Awaiting AskObject`)
		if not AskObject then
			repeat task.wait() until AskObject
		end
		return AskObject
	end
	IsNotCreated = true
	
	const PromptBackground = C "Frame" {
		Parent = props.Parent,
		AnchorPoint=Vector2.new(0.5, 1),
		BackgroundColor3=Colors["Div"],
		BorderSizePixel=0,
		Position=UDim2.new(0.5, 0, 0, -12),
		Size=UDim2.new(1, -24, 0, 0),
		ZIndex=9,
		AutomaticSize = Enum.AutomaticSize.Y,
	}
	C "UICorner" {
		Parent = PromptBackground,
		CornerRadius = UDim.new(0, 6),
	}
	;(C :: any) "UIShadow" {
		Parent = PromptBackground,
		Color = Colors.Outline,
		Spread = UDim2.fromOffset(4, 4),
		BlurRadius = UDim.new(0, 3),
	}
	C "UIListLayout" {
		Parent = PromptBackground,
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 0),
	}
	
	const PromptMain = C "Frame" {
		Parent = PromptBackground,
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = PromptBackground.BackgroundColor3,
		BorderSizePixel = 0,
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 3,
		UIPadding {4},
	}
	C "UICorner" {
		Parent = PromptMain,
		CornerRadius = UDim.new(0, 6),
	}
	
	const PromptTimelineWrapFullSize = UDim2.new(1, 0, 0, 3)
	const PromptTimelineWrap = C "Frame" {
		Parent = PromptBackground,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = PromptTimelineWrapFullSize,
		LayoutOrder = 3,
		ZIndex = 1,
		BackgroundTransparency = 1,
	}
	const Timeline = C "Frame" {
		Parent = PromptTimelineWrap,
		BackgroundColor3 = Colors["Hover"],
		Size = UDim2.new(1, 0, 2, 18),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
	}
	C "UICorner" {
		Parent = Timeline,
		CornerRadius = UDim.new(0, 6),
	}
	
	C "UIListLayout" {
		Parent = PromptMain,
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
	}
	const Question = C "TextLabel" {
		Parent = PromptMain,
		Text = "A request to https://example.json is required to continue, allow?",
		TextScaled = false,
		TextWrapped = true,
		TextColor3 = Colors["Text (Primary)"],
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		FontFace = FontFace.Main,
		TextSize = 18,
		RichText = true,
	}
	const Buttons = C "Frame" {
		Parent = PromptMain,
		Size = UDim2.new(1, 0, 0, 24),
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
	}
	--C "UIPadding" {
	--	Parent = Buttons,
	--	PaddingBottom = UDim.new(0, 4),
	--	PaddingTop = UDim.new(0, 4),
	--	PaddingLeft = UDim.new(0, 4),
	--	PaddingRight = UDim.new(0, 4),
	--}
	
	
	const Deny = C "TextButton" {
		Size = UDim2.new(0.5, -8, 1, 0),
		Position = UDim2.fromScale(0, 0.5),
		AnchorPoint = Vector2.new(0, 0.5),
		TextScaled = true,
		TextWrap = true,
		TextWrapped = true,
		Parent = Buttons,
		Text = "Deny",
		C "UICorner" {
			CornerRadius = UDim.new(0, 8),
		},
	}
	
	const DenyGUIB = GreatUIButton(Deny, Deny, {
		TweenInfo = TransitionTwInf,
		TextColor3 = Colors["Text (Buttons)"],
		BackgroundColor3 = Colors["Button"],
		UICorner = {
			TweenInfo = TransitionTwInf,
			CornerRadius=UDim.new(0, 8),
		},
	}):SetAppearance("Hover", {
		TweenInfo = TransitionTwInf,
		TextColor3 = Colors["Text (Hover)"],
		BackgroundColor3 = Colors["Red"],
		UICorner = {
			TweenInfo = TransitionTwInf,
			CornerRadius=UDim.new(0, 12),
		},
	}, true)
	
	const Allow = C "TextButton" {
		Size = UDim2.new(0.5, -8, 1, 0),
		Position = UDim2.fromScale(1, 0.5),
		AnchorPoint = Vector2.new(1, 0.5),
		TextScaled = true,
		TextWrap = true,
		TextWrapped = true,
		Parent = Buttons,
		Text = "Allow",
		C "UICorner" {
			CornerRadius = UDim.new(0, 8),
		},
	}
	
	const AllowGUIB = GreatUIButton(Allow, Allow, {
		TweenInfo = TransitionTwInf,
		TextColor3 = Colors["Text (Buttons)"],
		BackgroundColor3 = Colors["Button"],
		UICorner = {
			TweenInfo = TransitionTwInf,
			CornerRadius=UDim.new(0, 8),
		},
	}):SetAppearance("Hover", {
		TweenInfo = TransitionTwInf,
		TextColor3 = Colors["Text (Hover)"],
		BackgroundColor3 = Colors["Hover"],
		UICorner = {
			TweenInfo = TransitionTwInf,
			CornerRadius=UDim.new(0, 12),
		},
	}, true)
	
	
	local timeoutThread: thread?
	local timeoutId = 0
	local IsOpen: boolean = false
	const TimelineTween = TS:Create(
		PromptTimelineWrap,
		TimelineTwInf,
		{
			Size = UDim2.new(
				0,
				0,
				PromptTimelineWrapFullSize.Y.Scale,
				PromptTimelineWrapFullSize.Y.Offset
			),
		}
	)
	const OpenTween = TS:Create(
		PromptBackground,
		ToggleTwInf,
		{
			AnchorPoint=Vector2.new(0.5, 0),
			Position=UDim2.new(0.5, 0, 0, 12),
		}
	)
	const CloseTween = TS:Create(
		PromptBackground,
		ToggleTwInf,
		{
			AnchorPoint=Vector2.new(0.5, 1),
			Position=UDim2.new(0.5, 0, 0, -12),
		}
	)
	const OnAnswer: LemonSignal.Signal&lt;boolean, number&gt; = LemonSignal.new()
	
	-- Purely visual functions
	const function Open()
		if CloseTween.PlaybackState == Enum.PlaybackState.Playing then
			CloseTween:Cancel()
		end
		OpenTween:Play()
	end
	const function Close()
		if OpenTween.PlaybackState == Enum.PlaybackState.Playing then
			OpenTween:Cancel()
		end
		CloseTween:Play()
	end
	
	
	-- Logic functions
	const function Timeout(threadTimeoutId: number)
		if threadTimeoutId ~= timeoutId then
			return
		end
		
		timeoutThread = nil
		
		OnAnswer:Fire(false, threadTimeoutId)
		IsOpen = false
		Close()
	end
	const function StartTimeout()
		if TimelineTween.PlaybackState == Enum.PlaybackState.Playing then
			TimelineTween:Cancel()
		end

		PromptTimelineWrap.Size = PromptTimelineWrapFullSize
		TimelineTween:Play()

		timeoutThread = task.delay(TimelineTween.TweenInfo.Time, Timeout, timeoutId)
	end
	
	Deny.Activated:Connect(function()
		if timeoutThread then
			task.cancel(timeoutThread)
		end
		OnAnswer:Fire(false, timeoutId)
		IsOpen = false
		Close()
	end)
	Allow.Activated:Connect(function()
		if timeoutThread then
			task.cancel(timeoutThread)
		end
		OnAnswer:Fire(true, timeoutId)
		IsOpen = false
		Close()
	end)
	
	AskObject = {
		FixGreatUIButtonLooks = function(self: AskObject)
			DenyGUIB:ApplyAppearance("Hover")
			DenyGUIB:ApplyAppearance("Default")
			AllowGUIB:ApplyAppearance("Hover")
			AllowGUIB:ApplyAppearance("Default")
		end,
		Reparent = function(
			self: AskObject,
			newParent: Instance
		)
			PromptBackground.Parent = newParent
		end,
		OnAnswer = OnAnswer,
		Ask = function(
			self: AskObject,
			questionRichText: string,
			denialButtonText: string,
			approvalButtonText: string
		): number
			const previousTimeoutId = timeoutId
			timeoutId += 1
			
			Question.Text = questionRichText
			Deny.Text = denialButtonText
			Allow.Text = approvalButtonText

			if IsOpen then
				if timeoutThread then
					task.cancel(timeoutThread)
				end
				OnAnswer:Fire(false, previousTimeoutId) -- deny previous question
				StartTimeout()
				return timeoutId
			end

			Open()
			IsOpen = true
			StartTimeout()
			return timeoutId
		end,
	}
	
	table.freeze(AskObject)
	
	return AskObject :: AskObject
end</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="7">
              <Properties>
                <string name="Name">Checkbox</string>
                <string name="Source">--!strict
--!optimize 2

const TS = game:GetService(`TweenService`)

const Style = require(`../Style`)
const Colors = Style.Colors
const Vide = require(`../../Packages/Vide`)
const C = Vide.create
const source = Vide.source
const effect = Vide.effect
const GreatUIButton = require(`../../Packages/GreatUIButton`)
const LemonSignal = require(`../../Packages/LemonSignal`)

const TransitionTwInf = TweenInfo.new(0.1)



return function(
	props: {

	}
)

	const state = source(true)
	const onToggled: LemonSignal.Signal&lt;&gt; = LemonSignal.new()
	
	const HitBox = C "TextButton" {
		BackgroundTransparency = 1,
		Text = "",
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 9,
	}

	const checkbox = C "ImageLabel" {
		Size = UDim2.fromScale(0.171, 0.81),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.9, 0.5),
		Image = `rbxassetid://119003901253073`,
		ImageRectSize = Vector2.new(64, 64),
		ImageRectOffset = Vector2.new(0, 0),
		ImageColor3 = Colors["Text (Buttons)"],

		BackgroundTransparency = 1,

		C "UIAspectRatioConstraint" {
			AspectRatio = 1,
		},
		C "UICorner" {
			CornerRadius = UDim.new(0, 3),
		},
		(C :: any) "UISizeConstraint" {
			MaxSize = Vector2.new(64, 64),
		},
		(C :: any) "UIScale" {
			Scale = 1
		},
	}

	const greatCheckbox = GreatUIButton(checkbox, HitBox, {
		TweenInfo = TransitionTwInf,
		ImageColor3 = Colors["Text (Buttons)"],
		UICorner = {
			TweenInfo = TransitionTwInf,
			CornerRadius=UDim.new(0, 3),
		},
	})
		:SetAppearance(
			"Hover",
			{
				TweenInfo = TransitionTwInf,
				ImageColor3 = Colors["Text (Hover)"],
				UICorner = {
					TweenInfo = TransitionTwInf,
					CornerRadius=UDim.new(0, 6),
				},
			}
		)
		:SetAppearance(
			"Press",
			{
				TweenInfo = TransitionTwInf,
				UIScale = {
					TweenInfo = TransitionTwInf,
					Scale = 0.9,
				},
			}
		)
		:SetAppearance(
			"!Press",
			{
				TweenInfo = TransitionTwInf,
				UIScale = {
					TweenInfo = TransitionTwInf,
					Scale = 1,
				},
			},
			true
		)


	const ShowCross = TS:Create(
		checkbox,
		TransitionTwInf,
		{
			ImageRectOffset = Vector2.new(0, 0),
		}
	)
	const ShowCheck = TS:Create(
		checkbox,
		TransitionTwInf,
		{
			ImageRectOffset = Vector2.new(128, 0),
		}
	)
	--const ShowMixed = TS:Create(
	--	checkbox,
	--	TransitionTwInf,
	--	{
	--		ImageRectOffset = Vector2.new(64, 0),
	--	}
	--)
	
	const function SetDisplay(displayed: boolean)
		if displayed then
			ShowCheck:Play()
			return
		end
		ShowCross:Play()
		--if displayed &lt; 1 then
		--	ShowCheck:Play()
		--elseif displayed == 1 then
		--	ShowCross:Play()
		--else
		--	ShowMixed:Play()
		--end
	end

	greatCheckbox.OnPressStart:Connect(function()
		state(not state())
	end)
	effect(function()
		--print("Setting diplay to", state())
		SetDisplay(state())
		onToggled:Fire()
	end)

	return checkbox, HitBox, {
		GreatUIButton = greatCheckbox,
		DataState = state,
		OnToggled = onToggled,
	}
end</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="8">
              <Properties>
                <string name="Name">Div</string>
                <string name="Source">--!strict
--!optimize 2

const Style = require(`../Style`)
const Colors = Style.Colors
const FontStyle = Style.Font
const Vide = require(`../../Packages/Vide`)
const C = Vide.create

return function(
	props: {
		AnchorPoint: Vector2?,
		Size: UDim2?,
		Position: (UDim2 | Vide.Source&lt;UDim2&gt;)?,
		Radius: number?,
		AutoSize: ("Y" | "X" | "XY" | "None")?,
		Children: {Instance | GuiBase2d},
		Color: Color3?,
		ShadowColor: Color3?,
	}
)
	const autoSize = if type(props.AutoSize) == `string` then props.AutoSize else "Y"

	return C "Frame" {
		AnchorPoint = props.AnchorPoint or Vector2.new(.5, .5),
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.fromScale(.5, .5),
		
		AutomaticSize = Enum.AutomaticSize[autoSize],
		
		BorderSizePixel = 0,
		BackgroundColor3 = props.Color or Colors["Div"],
		
		C "UICorner" {
			CornerRadius = UDim.new(0, props.Radius or 6),
		},
		(C :: any) "UIShadow" {
			Color = props.ShadowColor or Colors["Button"],
			BlurRadius = UDim.new(0, 2),
			Spread = UDim2.fromOffset(1, 1),
			Transparency = 0,
		},
		table.unpack(props.Children),
	}
end</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="9">
              <Properties>
                <string name="Name">LoopedPattern</string>
                <string name="Source">--[[--
    LoopedPattern (a prototype used in CoffeeMixer &amp; SpidoznajaKozavka)
    Copyright © 2026 Coffilhg (Roblox UserId 517222346)

    This Source Code Form is subject to the terms of the Mozilla Public
    License, v. 2.0. If a copy of the MPL was not distributed with this
    file, You can obtain one at https://mozilla.org/MPL/2.0/.

    GitHub Repository/Branch with latest version, documentation, etc:
    https://github.com/Coffilhg/Useful-Components/tree/LoopedPattern
    Stars are appreciated!
    
    This is essentially a prototype / unpublished version of LoopedPattern,
    if the link https://github.com/Coffilhg/Useful-Components/tree/LoopedPattern
    leads nowhere, it means this component is not published yet, if you use it, this module is
    MPL-2.0 Licensed and made by @Coffilhg (Roblox UserId 517222346)
    This header shall be kept here without modifications.
--]]--

--!strict
--!optimize 2

const RunS = game:GetService(`RunService`)

const Style = require(`../Style`)
const Colors = Style.Colors
const Vide = require(`../../Packages/Vide`)
const C = Vide.create
const source = Vide.source
const derive = Vide.derive

export type LoopedPattern = {
	read PatternRBXAssetId: Vide.Source&lt;string&gt;,
	read PixelsPerTile: Vide.Source&lt;number&gt;,
	read SpeedMultiplier: Vide.Source&lt;number&gt;,
	read MovementAngleDegrees: Vide.Source&lt;number&gt;,
	read Play: (self: LoopedPattern) -&gt; (),
	read Pause: (self: LoopedPattern) -&gt; (),
}



--- Defaults &amp; Explanation
const PatternRBXAssetId = `rbxasset://textures/ui/GuiImagePlaceholder.png`
const TilePixels = 128
----const DoubleTilePixels = 2*TilePixels
--const TileSize = UDim2.fromOffset(TilePixels, TilePixels)
-- technically having TilePixels instead of DoubleTilePixels works,
-- but DoubleTilePixels just guarantees consistent look, even if
-- something ever breaks.
-- now once we added different directions, this is actually a necessity
-- unless we alse modify the starting position
--const BackgroundSize = UDim2.new(1, TilePixels, 1, TilePixels)
--const patternBgColor = Colors["Backgroung"]
--const SpeedMultiplier = (TilePixels / 3.96)


-- rotation as on a Unit Circle
-- e.g. (&lt; https://www.desmos.com/calculator/hxy0ltd2xd &gt;)
-- the pattern moves in the direction
-- towards the (SpeedMultiplierX, SpeedMultiplierY)
-- i.e. Nullpoint (0, 0) -&gt; (SpeedMultiplierX, SpeedMultiplierY)
const MovementAngleDegrees = 67 -- set this in angles
-- rest of the script handles everything math related
--const MovementAngleRadians = math.rad(MovementAngleDegrees)
--const SpeedMultiplierX = math.cos(MovementAngleRadians)
--const SpeedMultiplierY = math.sin(MovementAngleRadians)
--const MovementSpeedX = SpeedMultiplierX * SpeedMultiplier
--const MovementSpeedY = SpeedMultiplierY * SpeedMultiplier
--const StartPos = UDim2.fromOffset(
--	-TilePixels,
--	-TilePixels
--)

return function(
	props: {
		PatternRBXAssetId: string?,
		SpeedMultiplier: number?,
		MovementAngleDegrees: number?,
		PixelsPerTile: number?,
	}
): (ImageLabel, LoopedPattern)
	local connection: RBXScriptConnection?
	local x: number = 0
	local y: number = 0
	
	const assetId = props.PatternRBXAssetId
	const rbxAssetId: Vide.Source&lt;string&gt; = source(type(assetId) == `string` and assetId or PatternRBXAssetId)
	
	const pixels = props.PixelsPerTile
	const pixelsPerTile: Vide.Source&lt;number&gt; = source(type(pixels) == `number` and pixels or TilePixels)
	const tileSize = derive(function()
		return UDim2.fromOffset(pixelsPerTile(), pixelsPerTile())
	end)
	const backgroundSize = derive(function()
		return UDim2.new(1, pixelsPerTile(), 1, pixelsPerTile())
	end)
	
	const speed = props.SpeedMultiplier
	const speedMultiplier = derive(function()
		return type(speed) == `number` and pixelsPerTile() * speed or pixelsPerTile() / 3.96
	end)

	const angle = props.MovementAngleDegrees
	const movementAngleDegrees: Vide.Source&lt;number&gt; = source(type(angle) == `number` and angle or MovementAngleDegrees)
	const movementAngleRadians = derive(function()
		return math.rad(movementAngleDegrees())
	end)
	const speedMultiplierX = derive(function()
		return math.cos(movementAngleRadians())
	end)
	const speedMultiplierY = derive(function()
		return math.sin(movementAngleRadians())
	end)
	const movementSpeedX = derive(function()
		return speedMultiplierX() * speedMultiplier()
	end)
	const movementSpeedY = derive(function()
		return speedMultiplierY() * speedMultiplier()
	end)
	
	
	
	const pattern = C "ImageLabel" {
		Name = `Wrap`,
		Image = rbxAssetId,
		ScaleType = Enum.ScaleType.Tile,
		TileSize = tileSize,
		BackgroundColor3 = Colors["Backgroung"],
		--BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = backgroundSize,
		ImageTransparency = 0.37,
	}
	
	

	const function loop(dt: number)
		x = (x + dt * movementSpeedX()) % pixelsPerTile()
		y = (y - dt * movementSpeedY()) % pixelsPerTile()
		
		-- -pixelsPerTile is the starting pos
		pattern.Position = UDim2.fromOffset(
			-pixelsPerTile() + x,
			-pixelsPerTile() + y
		)
	end
	
	
	
	-- Lazy stop the background loop
	const function pauseBackgroundLoop(self: LoopedPattern)  -- self is unused
		if not (typeof(connection) == `RBXScriptConnection` and connection.Connected) then
			return
		end
		--print("Bg Loop Disconnected")
		connection:Disconnect()
		connection = nil
	end
	
	const loopedPattern = {
		PatternRBXAssetId = rbxAssetId,
		PixelsPerTile = pixelsPerTile,
		SpeedMultiplier = speedMultiplier,
		MovementAngleDegrees = movementAngleDegrees,
		Pause = pauseBackgroundLoop,
	}
	
	-- Lazy init the background loop
	function loopedPattern.Play(self: LoopedPattern) -- self is unused
		if typeof(connection) == `RBXScriptConnection` then
			return
		end
		--print("Bg Loop Connected")
		connection = RunS.PreRender:Connect(loop)
	end
	
	table.freeze(loopedPattern)
	
	;(Vide.cleanup :: any)(pauseBackgroundLoop)

	return pattern, loopedPattern :: LoopedPattern
end</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="10">
              <Properties>
                <string name="Name">Main</string>
                <string name="Source">--!strict
--!optimize 2

const Style = require(`../Style`)
const Colors = Style.Colors
const Vide = require(`../../Packages/Vide`)
const C = Vide.create

const UIPadding = require(`./UIPadding`)
const Padding = UDim.new(0.12, 0)


-- Returns the PluginUIBox and the Wrap to which all of the ForegroundChildren were parented;
-- BackgroundChildren are parented to PluginUIBox;
-- The Wrap has a ZIndex of 9;
return function(
	props: {
		--Parent: DockWidgetPluginGui,
		BackgroundChildren: {Instance | GuiBase2d},
		ForegroundChildren: {Instance | GuiBase2d},
	}
)
	
	const PluginUIBox = C "Frame" {
		--Parent = props.Parent,
		Name="PluginUIBox",
		BackgroundColor3=Colors["Backgroung"],
		BorderSizePixel=0,
		ClipsDescendants=true,
		Size=UDim2.new(1, 0, 1, 0),
		
		table.unpack(props.BackgroundChildren),
	}
	const Wrap = C "Frame" {
		Parent = PluginUIBox,
		Name="Wrap",
		BorderSizePixel=0,
		ClipsDescendants=true,
		BackgroundTransparency = 1,
		Size=UDim2.new(1, 0, 1, 0),
		ZIndex = 9,
		
		UIPadding {UDim.new(Padding.Scale * 1.5, Padding.Offset * 1.5), Padding, UDim.new(Padding.Scale / 2, Padding.Offset / 2), Padding},
		table.unpack(props.ForegroundChildren),
	}
	const UIPageLayout: UIPageLayout = (C :: any) "UIPageLayout" {
		Parent = Wrap,
		Animated = true,
		Circular = true,
		EasingDirection = Enum.EasingDirection.Out,
		EasingStyle = Enum.EasingStyle.Quint,
		GamepadInputEnabled = true,
		ScrollWheelInputEnabled = true,
		TouchInputEnabled = true,
		TweenTime = 0.6,
		Padding = UDim.new(Padding.Scale*2, Padding.Offset*2),
	}
	
	return PluginUIBox, Wrap, UIPageLayout
end</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="11">
              <Properties>
                <string name="Name">PlayerProfile</string>
                <string name="Source">--!strict
--!optimize 2

const TextService = game:GetService(`TextService`)

const ANameColorP = require(`../AdvancedNameColorPredictor`)
const Style = require(`../Style`)
const Colors = Style.Colors
const FontStyle = Style.Font
const RichGradient = require(`../../Packages/RichGradient`)
const Vide = require(`../../Packages/Vide`)
const C = Vide.create
const Div = require(`./Div`)
const Text = require(`./Text`)
const UIPadding = require(`./UIPadding`)
const ScrollingFrame = require(`./ScrollingFrame`)

const VerifiedBadge = ` {utf8.char(0xE000)}`

export type ThumbnailType = "AvatarHeadShot" | "Avatar" | "AvatarBust"
export type ThumbnailSize = "48" | "60" | "100" | "150" | "180" | "352" | "420" | number

return function(
	props: {
		AnchorPoint: Vector2?,
		Size: UDim2?,
		Position: UDim2?,
		Radius: number?,
		UserId: Vide.Source&lt;number&gt;,
		ThumbnailType: ThumbnailType,
		ThumbnailSize: ThumbnailSize,
		DisplayUsername: Vide.Source&lt;string&gt;,
		Username: Vide.Source&lt;string&gt;,
		PreviousUsernames: {string}?,
		HasVerifiedBadge: Vide.Source&lt;boolean&gt;,
	}
)
	const Image = C "ImageLabel" {
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(1, 1),
		AnchorPoint = Vector2.new(1, 1),
		Size = UDim2.fromScale(0.3, 1),
		C "UIAspectRatioConstraint" {
			AspectRatio = 1,
		},
		C "UICorner" {
			CornerRadius = UDim.new(0, props.Radius or 6),
		},
	}
	const uid, thumbnailType, thumbnailSize = props.UserId, props.ThumbnailType, props.ThumbnailSize
	Vide.effect(function()
		Image.Image = `rbxthumb://type={thumbnailType}&amp;id={uid()}&amp;w={thumbnailSize}&amp;h={thumbnailSize}`
	end)
	
	const DisplayUsername = Text {
		AnchorPoint = Vector2.zero,
		Size = UDim2.fromScale(.7, 0.6),
		Position = UDim2.fromScale(0, 0),
		AutoSize = "None",
		Children = {
			UIPadding {3},
		},
		Text = Vide.derive(function()
			return `&lt;b&gt;{props.DisplayUsername()}{props.HasVerifiedBadge() and VerifiedBadge or ``}&lt;/b&gt;`
		end),
		RichText = true,
		XAlign = "Left",
	}
	
	const TrueUsername = Text {
		AnchorPoint = Vector2.new(0, 1),
		Size = UDim2.fromScale(.7, 0.3),
		Position = UDim2.fromScale(0, 0.95),
		AutoSize = "None",
		Children = {
			UIPadding {3, 3, 3, 6},
		},
		Text = Vide.derive(function()
			const username = props.Username()
			return `&lt;b&gt;@{RichGradient:Apply(username, ANameColorP.ComputeNameGradient(username), true)}&lt;/b&gt;`
		end),
		RichText = true,
		XAlign = "Left",
	}
	TrueUsername.TextTransparency = 0.3
	
	const PreviousUsernames = Text {
		AnchorPoint = Vector2.new(0, 0),
		Size = UDim2.fromScale(1, 0),
		Position = UDim2.fromScale(0, 0),
		AutoSize = "Y",
		XAlign = "Left",
		YAlign = "Top",
	}
	PreviousUsernames.Font = Enum.Font.Code
	const PreviousUsernamesSF = ScrollingFrame {
		AnchorPoint = Vector2.new(0, 1),
		Size = UDim2.fromScale(.7, 0.4),
		Position = UDim2.fromScale(0, 1),
		Direction = "Y",
		Children = {PreviousUsernames, UIPadding {0, 0, 0, 6},}
	}
	PreviousUsernamesSF.BackgroundTransparency = 1
	
	const div = Div {
		AnchorPoint = props.AnchorPoint,
		Size = props.Size,
		Position = props.Position,
		Radius = props.Radius,
		AutoSize = "None",
		Children = {
			Image,
			DisplayUsername,
			TrueUsername,
			PreviousUsernamesSF
		},
	}
	
	const function SetPreviousUsernames(previousUsernames: {string}?)
		if type(previousUsernames) ~= `table` or #previousUsernames &lt; 1 then
			DisplayUsername.Size = UDim2.fromScale(.7, .6)
			TrueUsername.Size = UDim2.fromScale(.7, .3)
			TrueUsername.Position = UDim2.fromScale(0, 0.95)
			
			PreviousUsernamesSF.Visible = false
			PreviousUsernames.Text = ``
			return
		end
		DisplayUsername.Size = UDim2.fromScale(.7, .4)
		TrueUsername.Size = UDim2.fromScale(.7, .25)
		TrueUsername.Position = UDim2.fromScale(0, 0.6)
		
		const text = table.concat({
			"Previous usernames: @",
			table.concat(previousUsernames, `, @`)
		})
		const ActualTextBounds = TextService:GetTextSize(
			text,
			PreviousUsernames.TextSize,
			PreviousUsernames.Font,
			Vector2.new(PreviousUsernamesSF.AbsoluteSize.X, 10e100)
		)
		PreviousUsernames.Size = UDim2.new(1, 0, 0, ActualTextBounds.Y)
		PreviousUsernames.Text = text
		--print(props.Username(), #previousUsernames)
		PreviousUsernamesSF.Visible = true
	end
	SetPreviousUsernames(props.PreviousUsernames)
	
	return div, SetPreviousUsernames
	
end</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="12">
              <Properties>
                <string name="Name">Pre</string>
                <string name="Source">--!strict
--!optimize 2

const Style = require(`../Style`)
const Colors = Style.Colors
const FontStyle = Style.Font
const Vide = require(`../../Packages/Vide`)
const C = Vide.create
const ScrollingFrame = require(`./ScrollingFrame`)
const UIListLayout = require(`./UIListLayout`)
const UIPadding = require(`./UIPadding`)

return function(
	props: {
		AnchorPoint: Vector2?,
		Size: UDim2?,
		Position: UDim2?,
		Placeholder: string?,
		Text: string?,
		IsConstant: true?,
		Color: Color3?,
		RichText: boolean?,
	}
)
	const text: string = type(props.Text) == `string` and props.Text or ``
	
	const thePre = C "TextBox" {
		FontFace = FontStyle.Main,
		PlaceholderColor3=Colors["Text (Darker - Placeholder/Off)"],
		PlaceholderText=props.Placeholder or `Placeholder of PlaceholderText`,
		Text=text,
		TextColor3=props.Color or Colors["Text (Primary)"],
		TextSize=15,
		TextXAlignment=Enum.TextXAlignment.Left,	
		AutomaticSize=Enum.AutomaticSize.XY,
		BackgroundTransparency=1,
		BorderSizePixel=0,
		ClearTextOnFocus=false,
		Size=UDim2.fromScale(1, 0),
		RichText = not not props.RichText,
	}
	
	const sf = ScrollingFrame({
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		Direction = "XY",
		Children = {
			UIListLayout({
				XAlign = "Left",
				
			}),
			C "UICorner" {
				CornerRadius = UDim.new(0, 12),
			},
			UIPadding({24}),
			thePre,
		}
	})
	
	sf.BackgroundColor3 = Colors.Button
	
	if not not (props.IsConstant) then
		thePre:GetPropertyChangedSignal(`Text`):Connect(function()
			if thePre.Text == text then
				-- prevents infinite looping
				return
			end
			thePre.Text = text
		end)
	end

	return sf
end</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="13">
              <Properties>
                <string name="Name">PreNoWrap</string>
                <string name="Source"><![CDATA[--!strict
--!optimize 2

const Style = require(`../Style`)
const Colors = Style.Colors
const Vide = require(`../../Packages/Vide`)
const C = Vide.create
const UIPadding = require(`./UIPadding`)

return function(
	props: {
		AnchorPoint: Vector2?,
		Size: UDim2?,
		Position: UDim2?,
		Placeholder: string?,
		Text: string?,
		IsConstant: true?,
		Color: Color3?,
		RichText: boolean?,
	}
)
	local text: string = type(props.Text) == `string` and props.Text or ``

	local thePre = C("TextBox")({
		--FontFace = FontStyle.Main,
		Font = Enum.Font.Code,
		PlaceholderColor3=Colors["Text (Darker - Placeholder/Off)"],
		PlaceholderText=props.Placeholder or `Placeholder of PlaceholderText`,
		Text=text,
		TextColor3=props.Color or Colors["Text (Primary)"],
		TextSize=15,
		TextXAlignment=Enum.TextXAlignment.Left,	
		AutomaticSize=Enum.AutomaticSize.Y,
		BackgroundTransparency=1,
		BorderSizePixel=0,
		ClearTextOnFocus=false,
		Size=props.Size or UDim2.fromScale(1, 0),
		RichText = not not props.RichText,
		AnchorPoint = props.AnchorPoint or Vector2.new(.5, .5),
		Position = props.Position or UDim2.fromScale(.5, .5),
		TextWrapped = true,
		UIPadding({6}),
	})

	local function ApplyText(txt: string?)
		if type(txt) == "string" then
			text = txt
		end
		if thePre.Text == text then
			-- prevents infinite looping
			return
		end
		thePre.Text = text
	end

	if not not (props.IsConstant) then
		thePre:GetPropertyChangedSignal(`Text`):Connect(function()
			ApplyText(text)
		end)
	end

	return thePre, ApplyText
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="14">
              <Properties>
                <string name="Name">RichOutput</string>
                <string name="Source">--!strict
--!optimize 2

const Style = require(`../Style`)
const Colors = Style.Colors
const FontStyle = Style.Font
const Vide = require(`../../Packages/Vide`)
const C = Vide.create
const source = Vide.source
const effect = Vide.effect
const root = Vide.root

const ScrollingFrame = require(`./ScrollingFrame`)
const UIListLayout = require(`./UIListLayout`)
const UIPadding = require(`./UIPadding`)

export type RichOutputObject = {
	read Print: (
		self: RichOutputObject,
		...any
	) -&gt; (),
	read Warn: (
		self: RichOutputObject,
		...any
	) -&gt; (),
	read Error: (
		self: RichOutputObject,
		...any
	) -&gt; (),
	read HighlightedPrint: (
		self: RichOutputObject,
		...any
	) -&gt; (),
	read Clear: (
		self: RichOutputObject
	) -&gt; (),
}

-- https://create.roblox.com/docs/en-us/ui/rich-text
-- important color: df6af7
-- usual print: bcbec8

const DefaultMessage = `Plugin Debug Log will show up here`
const MaxLogLength = 200_000

-- RichOutput is a singleton: PluginBigSettingsStoreService needs a place
-- to log errors from as early as module-load time (well before Main's
-- Vide.mount ever runs), and does so via `RichOutputModule({} :: any)`
-- kept to a single variable - so the RichOutputObject (the thing with
-- :Error/:Print/etc) MUST be the first return value, exactly like the
-- old single-return RichOutput. Main wants the TextBox and
-- ScrollingFrame too, to embed in the UI, so those follow after.
--
-- Whichever of the two callers runs first is the one that actually
-- builds it - via its own Vide.root(), so it never depends on being
-- called from within an already-existing reactive scope - and every
-- later call (in either direction) just receives the same already-built
-- RichOutputObject / TextBox / ScrollingFrame back.
local isBuilt = false
local builtRichOutput: RichOutputObject
local builtPre: TextBox
local builtScrollingFrame: ScrollingFrame

return function(
	props: {}
): (RichOutputObject, TextBox, ScrollingFrame)
	if isBuilt then
		return builtRichOutput, builtPre, builtScrollingFrame
	end
	isBuilt = true

	const _destroy, richOutput, thePre, sf = root(function()
		const messages: {string} = {DefaultMessage}
		const logText = source(DefaultMessage)

		const function UpdateText()
			local log = table.concat(messages, "\n\n")
			while #log &gt; MaxLogLength and #messages &gt; 1 do
				table.remove(messages, 1)
				log = table.concat(messages, "\n\n")
			end
			logText(log)
		end

		-- format: a string to format via string.format including %s once
		const function Log(format: string, ...)
			const toConcat: {string} = {}
			for _, v in {...} do
				table.insert(toConcat, `{v}`)
			end

			const formatted = string.format(
				format,
				table.concat(toConcat, ", ")
			)

			table.insert(messages, table.concat({
				formatted,
				string.format("%.3f", os.clock()),
			}, "\t-\t"))
			UpdateText()
		end
		const function Clear()
			table.clear(messages)
			table.insert(messages, DefaultMessage)
			UpdateText()
		end

		const thePre = C "TextBox" {
			FontFace = FontStyle.Main,
			PlaceholderColor3 = Colors["Text (Darker - Placeholder/Off)"],
			PlaceholderText = `Plugin Debug Log will show up here`,
			Text = DefaultMessage,
			RichText = true,
			TextColor3 = Colors["Text (Primary)"],
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutomaticSize = Enum.AutomaticSize.XY,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			Size = UDim2.fromScale(1, 0),
		}

		-- Keeps the log read-only: any edit the user makes is immediately
		-- reverted back to the current log text - same guard Pre's
		-- IsConstant uses, just tracking a value that changes over time
		-- instead of a single fixed one.
		const function SyncText()
			if thePre.Text == logText() then
				return
			end
			thePre.Text = logText()
		end
		effect(SyncText)
		thePre:GetPropertyChangedSignal(`Text`):Connect(SyncText)

		const sf = ScrollingFrame({
			Direction = "XY",
			Children = {
				UIListLayout({
					XAlign = "Left",
				}),
				C "UICorner" {
					CornerRadius = UDim.new(0, 12),
				},
				UIPadding({24}),
				thePre,
			}
		})

		sf.BackgroundColor3 = Colors.Button

		const richOutput: RichOutputObject = {
			Print = function(self: RichOutputObject, ...)
				Log(`%s`, ...)
			end,
			Warn = function(self: RichOutputObject, ...)
				Log(`&lt;b&gt;&lt;font color="#f57630"&gt;%s&lt;/font&gt;&lt;/b&gt;`, ...)
			end,
			Error = function(self: RichOutputObject, ...)
				Log(`&lt;b&gt;&lt;font color="#e75750"&gt;%s&lt;/font&gt;&lt;/b&gt;`, ...)
			end,
			HighlightedPrint = function(self: RichOutputObject, ...)
				Log(`&lt;b&gt;&lt;font color="#df6af7"&gt;%s&lt;/font&gt;&lt;/b&gt;`, ...)
			end,
			Clear = function(self: RichOutputObject)
				Clear()
			end,
		}
		table.freeze(richOutput)

		return richOutput, thePre, sf
	end)

	builtRichOutput, builtPre, builtScrollingFrame = richOutput, thePre, sf

	return richOutput, thePre, sf
end</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="15">
              <Properties>
                <string name="Name">ScrollingFrame</string>
                <string name="Source">--!strict
--!optimize 2

const Style = require(`../Style`)
const Colors = Style.Colors
const Vide = require(`../../Packages/Vide`)
const C = Vide.create

-- A page
return function(
	props: {
		AnchorPoint: Vector2?,
		Size: UDim2?,
		Position: UDim2?,
		Direction: ("Y" | "X" | "XY")?,
		Children: {Instance | GuiBase2d},
	}
)
	const direction = if type(props.Direction) == `string` then props.Direction else "Y"
	
	const sf = C "ScrollingFrame" {
		AnchorPoint = props.AnchorPoint or Vector2.new(.5, .5),
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.fromScale(.5, .5),
		
		BackgroundColor3 = Colors["Div"],
		
		AutomaticCanvasSize = Enum.AutomaticSize[direction],
		ScrollingDirection = Enum.ScrollingDirection[direction],
		
		HorizontalScrollBarInset = Enum.ScrollBarInset[direction ~= "Y" and "Always" or "None"],
		VerticalScrollBarInset = Enum.ScrollBarInset[direction ~= "X" and "Always" or "None"],
		
		CanvasSize = UDim2.new(),
		BackgroundTransparency = 0,
		
		ScrollBarThickness = 9,
		
		
		
		C "UICorner" {
			CornerRadius = UDim.new(0, 6),
		},
		
		table.unpack(props.Children),
	}
	
	return sf
end</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="16">
              <Properties>
                <string name="Name">Text</string>
                <string name="Source">--!strict
--!optimize 2

const Style = require(`../Style`)
const Colors = Style.Colors
const FontStyle = Style.Font
const Vide = require(`../../Packages/Vide`)
const C = Vide.create

return function(
	props: {
		AnchorPoint: Vector2?,
		Size: UDim2?,
		Position: UDim2?,
		AutoSize: ("Y" | "X" | "XY" | "None")?,
		Children: {Instance | GuiBase2d}?,
		TextSize: number?,
		Text: (string | Vide.Source&lt;string&gt;)?,
		RichText: boolean?,
		XAlign: ("Left" | "Center" | "Right")?,
		YAlign: ("Top" | "Center" | "Bottom")?,
		Color: Color3?,
	}
)
	const autoSize = if type(props.AutoSize) == `string` then props.AutoSize else "Y"
	const xAlign = if type(props.XAlign) == `string` then props.XAlign else "Center"
	const yAlign = if type(props.YAlign) == `string` then props.YAlign else "Top"
	
	const properties = {
		AnchorPoint = props.AnchorPoint or Vector2.new(.5, .5),
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.fromScale(.5, .5),

		BackgroundTransparency = 1,

		AutomaticSize = Enum.AutomaticSize[autoSize],
		TextWrapped = true,
		TextScaled = autoSize == "None",
		TextSize = props.TextSize or 12,
		Text = props.Text or ``,
		TextXAlignment = Enum.TextXAlignment[xAlign],
		TextYAlignment = Enum.TextYAlignment[yAlign],
		
		RichText = not not props.RichText,
		
		FontFace = FontStyle.Main,
		
		TextColor3 = props.Color or Colors["Text (Primary)"],
	}
	
	if type(props.Children) == `table` then
		for _, child in props.Children do
			table.insert(properties, child)
		end
	end
	
	const textLabel = C("TextLabel")(properties :: any)
	
	--textLabel.Text = `{props.Text or ``}`
	
	return textLabel
end</string>
              </Properties>
