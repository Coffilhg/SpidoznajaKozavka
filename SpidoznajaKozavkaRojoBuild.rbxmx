-- The Version is available in this file: &lt;https://raw.githubusercontent.com/MaximumADHD/Roblox-Client-Tracker/master/version.txt&gt;

export type ClassNameTypePairsLeaf = {
	["Accessory"]: Accessory,
	["AccessoryDescription"]: AccessoryDescription,
