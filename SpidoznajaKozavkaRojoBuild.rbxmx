            <Item class="ModuleScript" referent="17">
              <Properties>
                <string name="Name">TextButton</string>
                <string name="Source">--!strict
--!optimize 2

const Style = require(`../Style`)
const Colors = Style.Colors
const FontStyle = Style.Font
const Vide = require(`../../Packages/Vide`)
const C = Vide.create
const GreatUIButton = require(`../../Packages/GreatUIButton`)
const UIPadding = require(`./UIPadding`)

const TransitionTwInf = TweenInfo.new(0.1)



return function(
	props: {
		AnchorPoint: Vector2?,
		Position: UDim2?,
		Size: UDim2?,
		Text: string | Vide.Source&lt;string&gt;,
		ZIndex: number?,
		RichText: boolean?,
	}
)

	const textButton = C "TextButton" {
		AnchorPoint = props.AnchorPoint or Vector2.new(.5, .5),
		Position = props.Position or UDim2.fromScale(.5, .5),
		Size = props.Size or UDim2.fromScale(1, 1),
		Text = props.Text,
		TextScaled = true,
		TextWrapped = true,
		ZIndex = props.ZIndex or 1,
		RichText = not not props.RichText,
		
		FontFace = FontStyle.Main,
		
		TextColor3 = Colors["Text (Buttons)"],
		BackgroundColor3=Colors["Button"],
		
		UIPadding({3}),
		C "UICorner" {
			Name="UICorner",
			CornerRadius=UDim.new(0, 6),
		},
		(C :: any) "UIScale" {
			Scale = 1
		}
	}
	
	const greatUIButton = GreatUIButton(textButton, textButton, {
		TweenInfo = TransitionTwInf,
		TextColor3 = Colors["Text (Buttons)"],
		BackgroundColor3=Colors["Button"],
		UICorner = {
			TweenInfo = TransitionTwInf,
			CornerRadius=UDim.new(0, 6),
		},
	})
	:SetAppearance(
		"Hover",
		{
			TweenInfo = TransitionTwInf,
			TextColor3 = Colors["Text (Hover)"],
			BackgroundColor3 = Colors["Hover"],
			UICorner = {
				TweenInfo = TransitionTwInf,
				CornerRadius=UDim.new(0, 12),
			},
		}
	)
	:SetAppearance(
		"Press",
		{
			TweenInfo = TransitionTwInf,
			UIScale = {
				TweenInfo = TransitionTwInf,
				Scale = 0.9,
			},
		}
	)
	:SetAppearance(
		"!Press",
		{
			TweenInfo = TransitionTwInf,
			UIScale = {
				TweenInfo = TransitionTwInf,
				Scale = 1,
			},
		},
		true
	)
	
	return textButton, greatUIButton
end</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="18">
              <Properties>
                <string name="Name">UIListLayout</string>
                <string name="Source">--!strict
--!optimize 2

const Vide = require(`../../Packages/Vide`)
const C = Vide.create

return function(
	props: {
		Direction: ("Vertical" | "Horizontal")?,
		XAlign: ("Left" | "Center" | "Right")?,
		YAlign: ("Top" | "Center" | "Bottom")?,
		SortOrder: ("Name" | "LayoutOrder")?,
		Padding: UDim?,
	}
)
	const direction = if type(props.Direction) == `string` then props.Direction else "Vertical"
	const xAlign = if type(props.XAlign) == `string` then props.XAlign else "Center"
	const yAlign = if type(props.YAlign) == `string` then props.YAlign else "Top"
	const sortOrder = if type(props.SortOrder) == `string` then props.SortOrder else "LayoutOrder"
	
	return C "UIListLayout" {
		FillDirection = Enum.FillDirection[direction],
		HorizontalAlignment = Enum.HorizontalAlignment[xAlign],
		VerticalAlignment = Enum.VerticalAlignment[yAlign],
		SortOrder = Enum.SortOrder[sortOrder],
		Padding = props.Padding or UDim.new(0, 12),
	}
end</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="19">
              <Properties>
                <string name="Name">UIPadding</string>
                <string name="Source">--!strict
--!optimize 2

const Vide = require(`../../Packages/Vide`)
const C = Vide.create

--- Default Padding ---
local Padding = UDim.new(0, 12)

local function toUDim(v: UDim | number)
	if typeof(v) == "UDim" then
		return v
	end

	if type(v) ~= "number" then
		return Padding
	end
	
	if math.isnan(v) or not math.isfinite(v) then
		return Padding
	end

	return UDim.new(0, v)
end

local cbs = {
	["0"] = function()
		return Padding, Padding, Padding, Padding
	end,
	["1"] = function(padding)
		local p = toUDim(padding[1])
		return p, p, p, p
	end,
	["2"] = function(padding)
		local xp = toUDim(padding[2])
		local yp = toUDim(padding[1])
		return yp, xp, yp, xp
	end,
	["3"] = function(padding)
		local xp = toUDim(padding[2])
		return toUDim(padding[1]), xp, toUDim(padding[3]), xp
	end,
	["4"] = function(padding)
		return toUDim(padding[1]), toUDim(padding[2]), toUDim(padding[3]), toUDim(padding[4])
	end,
}

local function normalizePadding(p : ({[number]: number | UDim} | {}))
	p = p or {}

	local t, r, b, l = cbs[`{math.min(#p, 4)}`](p)

	return {
		PaddingTop = t,
		PaddingRight = r,
		PaddingBottom = b,
		PaddingLeft = l,
	}
end

-- Write your paddingin a css like way
return function(
	PaddingOptions: ({[number]: number | UDim} | {})
): UIPadding
	return (C :: any)("UIPadding")(normalizePadding(PaddingOptions))  :: UIPadding
end</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="20">
              <Properties>
                <string name="Name">VirtualList</string>
                <string name="Source">-- What is Virtual Scrolling
-- https://medium.com/@sreekanthsreekanth970/virtual-scrolling-2797d722c6e2
-- Although I'd name it InfiniteScroll

--!strict
--!optimize 2

const Players = game:GetService(`Players`)
--print(Players:GetUserThumbnailAsync(517222346, Enum.ThumbnailType.AvatarThumbnail, Enum.ThumbnailSize.Size48x48))
--const AES = game:GetService(`AvatarEditorService`)

--AES:GetOutfitsAsync(Enum.OutfitSource.Created, Enum.OutfitType.Avatar)

const HumDescCache: {[number]: HumanoidDescription} = {}
const function GetHumDesc(outfitId: number): (boolean, HumanoidDescription)
	const cached = HumDescCache[outfitId]
	if cached then
		return true, cached
	end
	
	const success, humDesc = pcall(Players.GetHumanoidDescriptionFromOutfitIdAsync, Players, outfitId)
	if success and typeof(humDesc) == `Instance` and humDesc:IsA(`HumanoidDescription`) then
		HumDescCache[outfitId] = humDesc
		return true, humDesc
	end
	
	return false, humDesc
end
--const Assets = script.Parent.Parent.Parent.Assets
--const R6Rig = Assets.R6
--const R15Rig = Assets.R15

const Style = require(`../Style`)
const Colors = Style.Colors
const Reaction = require(`../../Packages/Reaction`)
const V, O, Copy = Reaction.V, Reaction.O, Reaction.C
const Vide = require(`../../Packages/Vide`)
const C = Vide.create
const Source = Vide.source
const GreatUIButton = require(`../../Packages/GreatUIButton`)

const Div = require(`./Div`)
const Text = require(`./Text`)

type Item = {
	name: string,
	id: number,
}
type InitialRow = number
type ElementManager = {
	-- implementation-specific (per-element)
	Id: Reaction.V&lt;number&gt;,
	Name: Reaction.V&lt;string&gt;,
	Main: Frame,
}
type Row = {
	-- general virtual scrolling (per-row)
	YOffset: Reaction.V&lt;number&gt;,
	CurrentRow: number,
	Elements: {ElementManager},
}

const ElementXScale = 0.46
const RowSize = 2
const PaddingXScale = 1 - ElementXScale * RowSize
const BufferSize = 1 -- 1 row buffer on each side
const TextYOffset = 24

-- A page
return function(
	props: {
		AnchorPoint: Vector2?,
		Size: UDim2?,
		Position: UDim2?,
		SelectedItem: Reaction.V&lt;number&gt;,
		SelectedItemMetadata: {
			Name: string,
			IsOutfit: boolean,
		},
		SelectedText: TextLabel,
		ApplySelectionText: (Instance, boolean, boolean?) -&gt; (),
		--Direction: ("Y" | "X" | "XY")?,
		--Children: {Instance | GuiBase2d},
	}
)
	const selectedItem = props.SelectedItem
	const selectedItemMetadata = props.SelectedItemMetadata
	const selectedText = props.SelectedText
	const applySelectionText = props.ApplySelectionText
	local list: {Item} = {} -- data
	const direction = "Y"--if type(props.Direction) == `string` then props.Direction else "Y"

	const sf = C "ScrollingFrame" {
		AnchorPoint = props.AnchorPoint or Vector2.new(.5, .5),
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.fromScale(.5, .5),

		BackgroundColor3 = Colors["Div"],

		AutomaticCanvasSize = Enum.AutomaticSize.None,
		ScrollingDirection = Enum.ScrollingDirection[direction],

		HorizontalScrollBarInset = Enum.ScrollBarInset[direction ~= "Y" and "Always" or "None"],
		VerticalScrollBarInset = Enum.ScrollBarInset[direction ~= "X" and "Always" or "None"],

		CanvasSize = UDim2.new(),
		BackgroundTransparency = 0,

		ScrollBarThickness = 9,

		C "UICorner" {
			CornerRadius = UDim.new(0, 6),
		},
	}
	
	-- mostly implementation-specific
	const function element(yOffset: Reaction.V&lt;number&gt;, isRight: boolean?)
		const xScale = not isRight and 0 or 1
		
		const id = V(0)
		const name = V("placeholder") :: Reaction.V&lt;string&gt;
		
		--const rig6 = R6Rig:Clone()
		--const rig6Hum = rig6.Humanoid
		--const rig6HRP = rig6.HumanoidRootPart
		--const rig15 = R15Rig:Clone()
		--const rig15Hum = rig15.Humanoid
		--const rig15HRP = rig15.HumanoidRootPart
		
		--rig6HRP.Anchored = true
		--rig15HRP.Anchored = true
		
		--const camera = C "Camera" {}
		--const function lookAtRig(isLookingAtR6: boolean)
		--	const rigHRP = isLookingAtR6 and rig6HRP or rig15HRP
		--	const pos = rigHRP.Position

		--	camera.CFrame = CFrame.lookAt(
		--		pos + Vector3.new(0, 0, -4.5),
		--		pos
		--	)
		--end
		--[[
		--const pos = rig15HRP.Position + (rig6HRP.Position - rig15HRP.Position) / 2
		--const camPos = pos + Vector3.new(0, 0, 8.1)
		--const camCF = CFrame.lookAt(
		--	camPos,
		--	pos
		--)
		--camera.CFrame = camCF
		
		--rig6HRP.CFrame = CFrame.lookAt(rig6HRP.Position, camPos)
		--rig15HRP.CFrame = CFrame.lookAt(rig15HRP.Position, camPos)
		--]]
		
		--const worldModel = C "WorldModel" {
		--	rig6,
		--	rig15
		--}
		
		--const viewport = (C :: any) "ViewportFrame" {
		--	Size = UDim2.fromScale(1, 1),
		--	Position = UDim2.fromScale(.5, .5),
		--	AnchorPoint = Vector2.new(.5, .5),
		--	BackgroundTransparency = 1,
		--	BorderSizePixel = 0,
		--	CurrentCamera = camera,
		--	worldModel,
		--	Archivable = true,
		--}
		
		
		
		
		
		const textLabel = Text {
			AutoSize = "None",
			XAlign = "Center",
			YAlign = "Center",
			RichText = true,
			Text = `&lt;i&gt;{name()}&lt;/i&gt;`,
			Size = UDim2.new(1, 0, 0, TextYOffset),
			AnchorPoint = Vector2.new(.5, 0),
			Position = UDim2.fromScale(.5, 1),
		}
		
		const ImageScale = (C :: any) "UIScale" {
			Scale = 1,
		}
		
		const Image = C "ImageLabel" {
			Size = UDim2.fromScale(.75, .75),
			AnchorPoint = Vector2.one / 2,
			Position = UDim2.fromScale(.5, .5),
			BorderSizePixel = 0,
			BackgroundTransparency = 1,
			ImageScale,
		}
		
		const HitBox = C "TextButton" {
			BackgroundTransparency = 1,
			Text = "",
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1) + UDim2.fromOffset(0, TextYOffset),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0),
			ZIndex = 9,
		}
		
		const main = Div({
			AnchorPoint = Vector2.new(xScale, 0),
			Size = UDim2.fromScale(ElementXScale, 1),
			Position = UDim2.new(xScale, 0, 0, yOffset()),
			AutoSize = "None",
			Children = {
				C "UIAspectRatioConstraint" {
					AspectRatio = 1,
				},
				textLabel,
				--viewport,
				Image,
				HitBox,
			},
		})
		main.ClipsDescendants = false
		
		const ggg = GreatUIButton(main, HitBox, {
			TweenInfo = TweenInfo.new(0.18),
			ImageLabel = {
				UIScale = {
					Scale = 1,
				},
			},
		} :: any)
			:SetAppearance("Hover", {
				TweenInfo = TweenInfo.new(0.18),
				ImageLabel = {
					UIScale = {
						Scale = 100/75,
					},
				},
			} :: any, true)
			:ApplyAppearance("Default")
		
		
		ggg.OnClick:Connect(function()
			selectedItemMetadata.Name = name()
			selectedItemMetadata.IsOutfit = true
			selectedItem(id())
			--applySelectionText(main, true)
		end)
		
		local isSelected = false
		
		local unseeSelection: () -&gt; ()
		unseeSelection = O(selectedItem, function(selectedId: number, isDestroyed)
			isSelected = selectedId == id()
			if isSelected then
				applySelectionText(main, true)
			end
			if isDestroyed then
				unseeSelection()
			end
		end)
		
		
		-- Vide' C doesnt support Reaction, so Imma do it using an observer
		local unsee: () -&gt; ()
		unsee = O(yOffset, function(value, isDestroyed)
			main.Position = UDim2.new(xScale, 0, 0, (value or 0) :: number)
			if isDestroyed then
				unsee()
			end
		end)
		--const text = Copy(function()
		--	return `{id()} &lt;i&gt;"{name()}"&lt;/i&gt;`
		--end)
		
		
		
		--local updateThread: thread
		--local currentlyDisplayedId: number = -1
		--const function ApplyId(humDescId: number)
		--	if currentlyDisplayedId == humDescId then
		--		return
		--	end
			
		--	local getDetailsSuccess, getDetailsResult = pcall(AES.GetOutfitDetailsAsync, AES, humDescId)
		--	while not getDetailsSuccess do
		--		getDetailsSuccess, getDetailsResult = pcall(AES.GetOutfitDetailsAsync, AES, humDescId)
		--	end
			
		--	local success, humDesc = GetHumDesc(humDescId)
		--	while not success do
		--		task.wait(3)
		--		success, humDesc = GetHumDesc(humDescId)
		--	end
			
		--	const isR6 = getDetailsResult[`PlayerAvatarType`] ~= `R15`
		--	lookAtRig(isR6)
		--	const hum = if isR6 then rig6Hum else rig15Hum
			
			
			
		--	local applySuccess, applyResult = pcall(hum.ApplyDescriptionAsync, hum, humDesc, Enum.AssetTypeVerification.Default)
		--	while not applySuccess do
		--		applySuccess, applyResult = pcall(hum.ApplyDescriptionAsync, hum, humDesc, Enum.AssetTypeVerification.Default)
		--	end
			
		--	currentlyDisplayedId = humDescId
		--end
		
		local unseeIdChange: () -&gt; ()
		unseeIdChange = O(id, function(humDescId: number, isDestroyed)
			--if updateThread then
			--	task.cancel(updateThread)
			--end
			--if currentlyDisplayedId == humDescId then
			--	return
			--end
			--updateThread = task.spawn(ApplyId, humDescId)
			if isSelected then
				selectedText.Visible = humDescId == selectedItem()
			end
			
			Image.Image = `rbxthumb://type=Outfit&amp;id={humDescId}&amp;w=420&amp;h=420`
			
			if isDestroyed then
				unseeIdChange()
			end
		end)
		
		local unseeNameChange: () -&gt; ()
		unseeNameChange = O(name, function(v: string, isDestroyed)
			textLabel.Text = `&lt;i&gt;{v}&lt;/i&gt;`
			if isDestroyed then
				unseeNameChange()
			end
		end)
		
		--local unseeText: () -&gt; ()
		--unseeText = O(text, function(value, isDestroyed)
		--	textLabel.Text = value :: string
		--	if isDestroyed then
		--		unseeText()
		--	end
		--end)
		main.Destroying:Once(function()
			unsee()
			unseeIdChange()
			Reaction.rmV(yOffset)
			Reaction.rmV(id)
			Reaction.rmV(name)
			--unseeText()
		end)
		
		main.Parent = sf
		
		const manager: ElementManager = {
			Id = id,
			Name = name,
			Main = main,
		}
		
		return main, manager
	end
	
	
	
	const rows: {[Row]: true} = {}
	local totalRows = 0
	local poolSize = 5
	local lastY = -999
	local lastAbsoluteSize = Vector2.zero
	local isUpdating = false
	local isPendingUpdate = false
	
	-- Update the data displayed by one pooled row.
	const function BindRow(row: Row, targetRow: number)
		const firstItemIndex = targetRow * RowSize

		for column, manager in row.Elements do
			const data = list[firstItemIndex + column]

			manager.Main.Visible = data ~= nil

			if data then
				manager.Id(data.id)
				manager.Name(data.name)
			end
		end
	end

	-- Create a new pooled row.
	const function CreateRow(): Row
		const yOffset = V(0)
		const _, left = element(yOffset, false)
		const _, right = element(yOffset, true)

		return {
			YOffset = yOffset,
			CurrentRow = -math.huge,
			Elements = {left, right},
		}
	end
	for i = 1, poolSize do
		rows[CreateRow()] = true
	end
	
	const function GetRequiredAndAvailableRows(y: number)
		const rangeStart = y - BufferSize
		const rangeEnd = rangeStart + poolSize - 1
		--print(rangeStart, rangeEnd)
		const availableRows: {Row} = {}
		const requiredRows: {[number]: boolean} = {}
		
		for i = rangeStart, rangeEnd do
			requiredRows[i] = true
		end
		for row in rows do
			const currentRow = row.CurrentRow
			if requiredRows[currentRow] then
				requiredRows[currentRow] = nil
				continue
			end
			table.insert(availableRows, row)
		end
		
		return requiredRows, availableRows
	end
	
	const function RepositionAllRows(rowYOffset: number)
		for row in rows do
			row.YOffset(row.CurrentRow * rowYOffset)
		end
	end
	const function CompleteUpdate(y: number, rowYOffset: number, isRepositioningRequired: boolean)
		const requiredRows, availableRows = GetRequiredAndAvailableRows(y)

		local i = 1
		const available = #availableRows
		for yy in requiredRows do
			if i &gt; available then
				warn(`#requiredRows is bigger than #availableRows`)
				break
			end
			const row: Row = availableRows[i]
			row.CurrentRow = yy
			if not isRepositioningRequired then
				row.YOffset(yy * rowYOffset)
			end

			BindRow(row, yy)

			i += 1
		end
		
		if isRepositioningRequired then
			RepositionAllRows(rowYOffset)
		end

		isUpdating = false
	end

	const function Update()
		if isUpdating then
			isPendingUpdate = true
			return
		end
		isUpdating = true
		
		const absoluteSize = sf.AbsoluteSize
		if absoluteSize.X &lt; 10 then
			isUpdating = false
			return
		end
		
		const elementYOffset = absoluteSize.X * ElementXScale + TextYOffset
		const paddingYOffset = absoluteSize.X * PaddingXScale
		const rowYOffset = elementYOffset + paddingYOffset
		
		--								(element height + padding) * (full rows - 1) + element height -- perfect airtight fit with no unecessary padding at the bottom
		-- edge case: with #list % RowSize == 0, it must actually be math.floor(#list / RowSize) - paddingYOffset or (math.floor(#list / RowSize) - 1) + elementYOffset
		sf.CanvasSize = UDim2.fromOffset(0, rowYOffset * totalRows + elementYOffset)
		sf.Visible = totalRows &gt; 0
		
		if rowYOffset &lt; 10 then
			isUpdating = false
			return
		end
		
		const y = math.floor(sf.CanvasPosition.Y / rowYOffset) -- row offset
		--const currentPoolSize = math.ceil(absoluteSize.Y / rowYOffset) + BufferSize * 2
		
		--if currentPoolSize ~= poolSize then
		--	isPendingUpdate = false
			
		--	if currentPoolSize &gt; poolSize then
		--		for _ = poolSize + 1, currentPoolSize do
		--			rows[CreateRow()] = true
		--		end
		--		poolSize = currentPoolSize
		--		CompleteUpdate(y, rowYOffset)
		--	else
		--		poolSize = currentPoolSize
				
		--		const requiredRows, availableRows = GetRequiredAndAvailableRows(y)
				
		--		local i = 1
		--		const available = #availableRows
		--		for yy in requiredRows do
		--			if i &gt; available then
		--				warn(`#requiredRows is bigger than #availableRows`)
		--				break
		--			end
		--			const row: Row = availableRows[i]
		--			row.CurrentRow = yy
		--			row.YOffset(yy * rowYOffset)

		--			BindRow(row, yy)

		--			i += 1
		--		end
				
		--		for a = i, available do
		--			const row: Row = availableRows[a]
		--			rows[row] = nil
					
		--			if row then
		--				for _, m in row.Elements do
		--					m.Main:Destroy()
		--				end
		--			end
		--		end
				
		--		isUpdating = false
		--	end
			
		--	if isPendingUpdate then
		--		isPendingUpdate = false
		--		Update()
		--	end
			
		--	return
		--end
		
		const isRepositioningRequired = lastAbsoluteSize ~= absoluteSize
		if lastY == y then
			if isRepositioningRequired then
				RepositionAllRows(rowYOffset)
			end
			isUpdating = false
			return
		end
		lastY = y
		
		CompleteUpdate(y, rowYOffset, isRepositioningRequired)
	end
	
	
	
	const function SetList(newList: {Item})
		list = newList
		
		const listLen = #list
		const floorRows = math.floor(listLen / RowSize)
		totalRows = listLen % RowSize == 0 and floorRows - 1 or floorRows
		
		for row in rows do
			BindRow(row, row.CurrentRow)
		end
		lastY = -999
		Update()
	end
	
	sf:GetPropertyChangedSignal("CanvasPosition"):Connect(Update)
	sf:GetPropertyChangedSignal("AbsoluteSize"):Connect(Update)
	Update()

	return sf, SetList
end</string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="21">
            <Properties>
              <string name="Name">HTTP</string>
              <string name="Source">--!strict
--!optimize 2

const HttpService = game:GetService(`HttpService`)

const Ask = require(`./Components/Ask`)
const AskObject = Ask({})
const OnAnswer = AskObject.OnAnswer



const IsDebugEnabled: boolean = false



const function GetAsync(url: any)
	return HttpService:GetAsync(url)
end
const function JSONDecode(json: any)
	return HttpService:JSONDecode(json)
end


export type UsersByNameResponse = {
	data: {
		[number]: {
			displayName: string,
			hasVerifiedBadge: boolean,
			id: number,
			name: string,
			previousUsernames: {string},
		},
	},
	nextPageCursor: string,
}
export type outfitType = "Avatar" | "DynamicHead" | string
export type OutfitsByUserIdResponseData = {
	[number]: {
		id: number,
		isEditable: boolean,
		name: string,
		outfitType: outfitType,
	},
}
export type OutfitsByUserIdResponse = {
	data: OutfitsByUserIdResponseData,
	paginationToken: string,
}


const HTTP = {
	Links = table.freeze({
		Outfits = {
			-- self explanatory
			Format = function(UID: number, ItemsPerPage: number, PaginationToken: string?, OutfitType: outfitType?, IsEditable: boolean?)
				-- page={Page} doesn't work either way. By default it is 1, if no pagination token is provided it is 1 regardless of sent value.
				-- with a pagination token, roblox returns only the next page that is bound to this pagination token.
				return `https://avatar.roproxy.com/v2/avatar/users/{UID}/outfits?itemsPerPage={ItemsPerPage}{
				type(PaginationToken) == `string` and `&amp;paginationToken={PaginationToken}` or ``
				}{
				type(OutfitType) == `string` and `&amp;outfitType={OutfitType}` or ``
				}{
				type(IsEditable) == `boolean` and `&amp;isEditable={IsEditable}` or ``
				}`
			end,
			Read = `https://avatar.roproxy.com/v2/avatar/users/\{UID}/outfits?itemsPerPage=\{ItemsPerPage} and optional &amp;paginationToken=\{PaginationToken} &amp;outfitType=\{OutfitType} &amp;isEditable=\{IsEditable}`,
		},
		UsersByName = {
			-- keyword string and limit 10 | 25 | 50 | 100 expected
			Format = function(keyword: string, limit: number)
				return `https://users.roproxy.com/v1/users/search?keyword={keyword}&amp;limit={limit}`
			end,
			Read = `https://users.roproxy.com/v1/users/search?keyword=\{keyword}&amp;limit=\{limit}`,
		},
	}),
}

function HTTP.Fetch(
	self: HTTP,
	url: string,
	isJSONDecodeRequired: boolean?,
	isAllowed: boolean?,
	reason: string?,
	yes: string?,
	no: string?
): (boolean, string | any)
	if isAllowed ~= true then
		const questionId = AskObject:Ask(
			`Please approve HttpService:GetAsync to "{url}"{reason and `;\n{reason}` or ``}`,
			no or `Deny`,
			yes or `Allow`
		)
		local approved, answerId = OnAnswer:Wait()

		while answerId ~= questionId do
			if answerId &gt; questionId then
				-- the question was already answered and we missed it (idk how, but it's good to handle this)
				return false, `Question was answered too fast or automatically, answer status missing`
			end
			approved, answerId = OnAnswer:Wait() -- keep awaiting until it's our question' answer status
		end

		if not approved then
			return false, `HttpService:GetAsync request to "{url}" was denied, can not proceed`
		end
	end
	
	
	
	const success, result = pcall(GetAsync, url)
	if not (success and isJSONDecodeRequired) then
		if not not IsDebugEnabled then
			print(`{`[HTTP] \{{url}}`}\n\t{success}`, result)
		end
		return success, result
	end
	
	
	
	const ok, decoded = pcall(JSONDecode, result)
	
	
	
	if not not IsDebugEnabled then
		print(`{`[HTTP] \{{url}}`}\n\t{ok}`, decoded)
	end
	if not ok then
		return ok, result
	end
	return ok, decoded
end

table.freeze(HTTP)
type HTTP = typeof(HTTP)
return HTTP</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="22">
            <Properties>
              <string name="Name">HumanoidDescriptionUtils</string>
              <string name="Source">--!strict
--!optimize 2

const Utils = {}

const Players = game:GetService(`Players`)
const AES = game:GetService(`AvatarEditorService`)


type userId = number
type outfitId = number
type isSuccessBoolean = boolean





const HumDescCache: {[userId]: HumanoidDescription} = {}
-- Second return argument is a HumanoidDescription only if isSuccessBoolean == true
const function GetHumDesc(userId: userId): (isSuccessBoolean, HumanoidDescription)
	const cached = HumDescCache[userId]
	if cached then
		return true, cached
	end

	const success, humDesc = pcall(Players.GetHumanoidDescriptionFromUserIdAsync, Players, userId :: any) -- Roblox expects a new type "User", but still supports numbers and this is a plugin so we'll never get a proper "User" type value
	if success and typeof(humDesc) == `Instance` and humDesc:IsA(`HumanoidDescription`) then
		HumDescCache[userId] = humDesc
		return true, humDesc
	end

	return false, humDesc
end
Utils.GetHumDesc = GetHumDesc

const OutfitsCache: {[outfitId]: HumanoidDescription} = {}
-- Second return argument is a HumanoidDescription only if isSuccessBoolean == true
const function GetOutfit(outfitId: outfitId): (isSuccessBoolean, HumanoidDescription)
	const cached = OutfitsCache[outfitId]
	if cached then
		return true, cached
	end

	const success, humDesc = pcall(Players.GetHumanoidDescriptionFromOutfitIdAsync, Players, outfitId)
	if success and typeof(humDesc) == `Instance` and humDesc:IsA(`HumanoidDescription`) then
		OutfitsCache[outfitId] = humDesc
		return true, humDesc
	end

	return false, humDesc
end
Utils.GetOutfit = GetOutfit

-- Yields for however long required
const function GetHumDescDetails(userId: userId)
	local getDetailsSuccess, getDetailsResult = pcall(Players.GetCharacterAppearanceInfoAsync, Players, userId :: any) -- "User"
	--print(getDetailsSuccess, getDetailsResult)
	while not getDetailsSuccess do
		--print(getDetailsSuccess, getDetailsResult)
		getDetailsSuccess, getDetailsResult = pcall(Players.GetCharacterAppearanceInfoAsync, Players, userId :: any) -- "User"
	end
	
	return getDetailsResult
end
Utils.GetHumDescDetails = GetHumDescDetails

-- Yields for however long required
const function IsHumDescR6(userId: userId): boolean
	const getDetailsResult = GetHumDescDetails(userId)

	const isR6 = getDetailsResult[`playerAvatarType`] ~= `R15`

	return isR6 --getDetailsResult
end
Utils.IsHumDescR6 = IsHumDescR6

-- Yields for however long required
const function IsOutfitR6(outfitId: outfitId): boolean
	local getDetailsSuccess, getDetailsResult = pcall(AES.GetOutfitDetailsAsync, AES, outfitId)
	--print(getDetailsSuccess, getDetailsResult)
	while not getDetailsSuccess do
		--print(getDetailsSuccess, getDetailsResult)
		getDetailsSuccess, getDetailsResult = pcall(AES.GetOutfitDetailsAsync, AES, outfitId)
	end
	
	const isR6 = getDetailsResult[`PlayerAvatarType`] ~= `R15`
	
	return isR6 --getDetailsResult
end
Utils.IsOutfitR6 = IsOutfitR6



table.freeze(Utils)
export type Utils = typeof(Utils)
return Utils</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="23">
            <Properties>
              <string name="Name">Linguistics</string>
              <string name="Source">--!strict
--!optimize 2

const Linguistics = {}

-- Suffix - a morpheme or ending added to the end of a word
-- Usually referred to as a "Postfix" in programming tho;
-- Example usage:
-- English (Default) `:WordPerAmount(123)`
-- Ukrainian `:WordPerAmount(123, ``, `и`, `ів`)`
-- Russian `:WordPerAmount(123, ``, `а`, `ов`)`
function Linguistics.WordPerAmount(
	self: Linguistics,
	number: number,
	singleSuffix: string?,
	multipleSuffix: string?,
	moreSuffix: string?,
	includeNumber: boolean?
): string
	if type(number) ~= `number` then
		return ``
	end

	-- English fallback suffixes (postfixes)
	if type(singleSuffix) ~= `string` then
		singleSuffix = ``
	end
	if type(multipleSuffix) ~= `string` then
		multipleSuffix = `s`
	end
	if type(moreSuffix) ~= `string` then
		moreSuffix = `s`
	end
	
	const n = not includeNumber and `` or `{number}`

	const numberModuleHundred = number % 100
	if numberModuleHundred &gt; 4 and numberModuleHundred &lt; 21 then
		return `{n}{moreSuffix}`
	end

	const numberModuleTen = number % 10
	if numberModuleTen &gt; 4 or numberModuleTen == 0 then
		return `{n}{moreSuffix}`
	end

	if numberModuleTen &gt; 1 then
		return `{n}{multipleSuffix}`
	end

	return `{n}{singleSuffix}`
end

table.freeze(Linguistics)
export type Linguistics = typeof(Linguistics)
return Linguistics</string>
            </Properties>
          </Item>
